      "about": [
        {
          "@type": "DefinedTerm",
          "@id": "@@PAGE@@#defined-term",
          "name": "Client service tech stack",
          "description": "The client service tech stack is every tool your account team touches to keep a client relationship running: the system that holds the contact, the tool that captures the call, the dashboard that scores the relationship, and whatever drafts the follow-up afterward.",
          "inDefinedTermSet": "@@ROOT@@/blog/"
        },
        {
          "@type": "Thing",
          "name": "Customer success",
          "sameAs": "https://en.wikipedia.org/wiki/Customer_success"
        },
        {
