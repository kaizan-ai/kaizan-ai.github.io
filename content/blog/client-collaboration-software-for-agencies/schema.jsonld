    {
      "@type": "FAQPage",
      "@id": "@@PAGE@@#faq",
      "url": "@@PAGE@@#faq",
      "isPartOf": {
        "@id": "@@PAGE@@#webpage"
      },
      "inLanguage": "@@LANG@@",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is a client portal, and how is it different from client collaboration software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Client collaboration software gives agencies and their clients one shared place to work together: files, approvals, messages and progress updates. A client portal is the branded front door to that space, and the shared system behind it is often described as a client collaboration platform. Neither tells your team how the client feels. That internal view of health, risk and stakeholder coverage needs a second layer behind the portal.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What is the best client dashboard software for agencies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The best client dashboard software depends on the audience. For clients, a portal such as SuiteDash, Clinked or Copilot shows progress and deliverables. For your own team, an internal dashboard such as Kaizan combines reporting features with health, risk, and coverage scoring drawn from real conversations. Most agencies need one of each.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What is client tracking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Client tracking is the continuous record of every interaction with a client: emails, meetings, calls and chat, tied to the people involved. Tracking done by hand goes stale. Tracking captured automatically shows when contact thins, who is missing from the conversation and which accounts need attention before the client raises it.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What should clients see, and what should stay internal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Clients should see progress, deliverables awaiting approval, reporting and agreed next steps. Keep client health scores, risk flags, stakeholder coverage, margin and renewal signals internal. The client lane builds trust. The internal lane protects the account. Mixing them hands clients your working notes and hides your warning signs.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Do agencies actually need a client portal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not always. Agencies need a portal when clients chase files, approvals or status in email every week, and some clients may also need a user friendly interface to adopt it quickly. Agencies with a handful of clients and a shared drive can skip it. If the real problem is losing clients without warning, a portal with a steep learning curve does not fix it either. Internal visibility does.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "How do we stop the portal going stale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Stop depending on manual updates. Pull progress from the tools your team already uses, and capture meetings, emails and calls automatically so the status draws from real activity. Name one update owner per account, and retire any portal section nobody has opened in 30 days.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "How do we roll a portal out to existing clients?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Pilot with five accounts, never the whole book. Tell each client what changes, what stays in email and when the first update lands. Seed the portal with current files and open actions before you invite clients. Review usage after 30 days, then extend to the next group.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Will the team actually use it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Adoption follows effort. The entire team will only use the portal if it removes work rather than adds it. Choose tools that reuse work already done, assign one owner per account and track weekly logins by account team. A portal that adds admin fails. One that removes admin and has an intuitive interface sticks.",
            "inLanguage": "@@LANG@@"
          }
        }
      ]
    },
