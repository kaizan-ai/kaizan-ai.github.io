    {
      "@type": "FAQPage",
      "@id": "@@PAGE@@#faq",
      "url": "@@PAGE@@#faq",
      "isPartOf": {
        "@id": "@@PAGE@@#webpage"
      },
      "inLanguage": "@@LANG@@",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the best account management software for agencies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For agencies and professional services firms managing a portfolio of retained clients, Kaizan is built specifically for that shape of book. For firms already standardised on Salesforce, or managing a handful of very large enterprise accounts, Salesforce Sales Cloud or DemandFarm may fit better.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What is key account management software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Software built for a small number of large, strategic, multi-stakeholder accounts, with deep relationship mapping and account planning. DemandFarm and Kapta lead this category. Wrong fit for a volume book of dozens or hundreds of retained clients.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What is account planning software, and what should an account plan include?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It manages the living document for a client relationship: objective, stakeholder map, health, white space, renewal risk and next actions. See the worked example above.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Do we need account management software if we already have a CRM?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Usually yes, because a CRM and account management software answer different questions. The right account management software should fit your team’s workflows and the tools you already use. The exception is a firm managing a handful of very large accounts, where a key-account tool on top of the CRM may close the gap.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "How much does account management software cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Three pricing models: per seat ($12–$150/user/month), per client (Kaizan, priced by number of clients with unlimited users, price on quote), and quote-based. Run the numbers for your own ratio of staff to clients, and use free trials or demos before you choose account management software.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "How should we evaluate options?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Compare customisation, onboarding, integrations and reporting against your team size, current workflows and growth plans.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Is there free account management software?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Salesforce, HubSpot and Zoho CRM all have free tiers, but none includes account health scoring, risk alerting or stakeholder coverage.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What does each person in the buying committee need to see?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Head of Client Service needs proof it replaces the manual spreadsheet. The Head of Ops/COO needs cost to deliver and adoption proof. The CEO/CFO needs revenue protected and expanded.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Will this replace our RAG spreadsheet?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "If the tool captures activity automatically and scores health continuously, yes. If it still requires manual logging, it's a prettier spreadsheet, not a replacement.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Will the team actually use it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Adoption lives or dies on whether the tool requires manual logging. An intuitive user interface matters here too, alongside automatic capture. Automatic capture tools see far higher sustained use.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Can account management software integrate with existing tools?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, account management software integrate with email, calendar, CRM and finance tools so account data moves between the systems your team already relies on.",
            "inLanguage": "@@LANG@@"
          }
        }
      ]
    },
