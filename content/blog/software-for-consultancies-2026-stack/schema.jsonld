    {
      "@type": "FAQPage",
      "@id": "@@PAGE@@#faq",
      "url": "@@PAGE@@#faq",
      "isPartOf": {
        "@id": "@@PAGE@@#webpage"
      },
      "inLanguage": "@@LANG@@",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What software does a consultancy need?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Software for consultancy firms covers five core jobs as its key features: winning work, planning and staffing, delivering projects, billing time, and keeping clients. Most consultancies cover the first four well and run the fifth on a spreadsheet and memory. A complete stack has one tool per job, and the fifth tool protects the revenue the other four create.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "How much does software for a consultancy cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Cost depends on the pricing model. Per-seat tools charge per user per month, and rates vary by plan, so request a quote for your headcount. Per-client platforms charge by portfolio size. Kaizan is priced by number of clients, with unlimited users. Price on quote.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Is there free software for consultancies?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, for parts of the stack. HubSpot offers a free CRM for contacts and deals. Free tiers stop where consultancies need help most: multi-team permissions, utilisation reporting and client health. Kaizan offers a free 14-day pilot on your own client data, with no card and no commitment.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Do we need it if we already have a CRM or a PSA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, if you cannot say which clients are at risk and why. A CRM records contacts and deals. A PSA records time, cost and margin. Neither captures the emails and calls where clients signal trouble. Keep both, and add a client success layer when the evidence sits outside your systems.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "How long does it take to roll out?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It depends on the type. CRMs and time trackers typically go live in days but need weeks of entry before reports mean anything. PSA suites typically take weeks to months to configure. Kaizan goes live the same day through OAuth, and its free 14-day pilot delivers client health scores and findings by day 14.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "What is the return on this?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Measure return in revenue protected and expansion won, not hours saved. In a modelled 200-person consultancy with 60 clients, the calculator method returns about $3.4 million in annual benefit before platform cost, which is priced on quote. Treat it as a model, not a forecast. Run the live calculator with your own numbers.",
            "inLanguage": "@@LANG@@"
          }
        },
        {
          "@type": "Question",
          "name": "Will the team actually use it?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Adoption follows effort. Tools that need manual entry get skipped. Pick tools that capture client emails and calls automatically, set permissions before launch, and pilot on five accounts for 14 days. Measure weekly active users against seats. Under 50% utilisation after 60 days means the wrong fit or a rollout that needs work. Run the numbers, and book a demo when you want to see your own clients scored.",
            "inLanguage": "@@LANG@@"
          }
        }
      ]
    },
    {
      "@type": "HowTo",
      "@id": "@@PAGE@@#howto",
      "name": "How to choose in seven steps",
      "inLanguage": "@@LANG@@",
      "step": [
        {
          "@type": "HowToStep",
          "position": 1,
          "name": "Name the problem first",
          "text": "Write one sentence: \"We lose clients without warning\" or \"We bill late.\" Use the decision table above to find the job."
        },
        {
          "@type": "HowToStep",
          "position": 2,
          "name": "Map your current stack",
          "text": "List every tool, owner, seat count and cost. Aim to do it in 60 minutes."
        },
        {
          "@type": "HowToStep",
          "position": 3,
          "name": "Count clients, not only seats",
          "text": "Per-seat tools scale with headcount. Per-client tools scale with portfolio. Model both at your size."
        },
        {
          "@type": "HowToStep",
          "position": 4,
          "name": "Test manual entry against automatic capture",
          "text": "If your team must type the data, adoption will decide the outcome. Choose capture that needs no extra admin."
        },
        {
          "@type": "HowToStep",
          "position": 5,
          "name": "Pilot on five accounts for 14 days",
          "text": "Pick a mix: two healthy accounts, two uncertain, one you worry about. Check whether the tool tells you something you did not know."
        },
        {
          "@type": "HowToStep",
          "position": 6,
          "name": "Ask what each buyer needs to see",
          "text": "The CEO wants revenue at risk. The CFO wants cost and payback. The COO wants adoption and admin time per account director."
        },
        {
          "@type": "HowToStep",
          "position": 7,
          "name": "Score the shortlist",
          "text": "Weight the criteria, score each tool, and rank them."
        }
      ]
    },
